<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit_product_custom" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//table//thead//tr//th[1]" position="before">
            <th class="text-start"><span>Product ID</span></th>
        </xpath>

        <xpath expr="//table//tbody//tr[1]//td[1]" position="before">
            <td>
                <span t-field="line.product_id.product_custom_id"/>
            </td>
        </xpath>
    </template>
</odoo>