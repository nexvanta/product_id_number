<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_inherit_product_custom" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.product.id</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="before">
                <field name="product_custom_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_quant_tree_inventory_report_id" model="ir.ui.view">
        <field name="name">stock.quant.inventory.report.inherit.product.id</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_custom_id" string="Product ID" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>