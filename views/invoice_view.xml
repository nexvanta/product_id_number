<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_form_product_custom_id" model="ir.ui.view">
        <field name="name">account.move.form.product.custom.id</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="before">
                <field name="product_custom_id" string="Product ID" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>