<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_custom_id" model="ir.ui.view">
        <field name="name">product.template.form.inherit.custom.id</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="product_custom_id" placeholder="e.g. PROD-001"/>
            </xpath>
        </field>
    </record>


    <record id="view_stock_quantity_history_inherit_product_id" model="ir.ui.view">
    <field name="name">stock.quant.list.inherit.product.id</field>
    <field name="model">stock.quant</field>
    <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='product_id']" position="after">
            <field name="product_custom_id" string="Product ID" optional="show"/>
        </xpath>
    </field>
</record>
</odoo>